DATABASE_URL=
# lets `pnpm db:push:prod` target main while DATABASE_URL points at the dev branch
DATABASE_URL_PROD=
SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# the organiser: requests with no @person go to them; the id pins it (usernames can be re-claimed)
SUPERADMIN_USERNAME=
SUPERADMIN_TELEGRAM_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# optional: signs public file URLs (falls back to SESSION_SECRET)
FILES_SECRET=
# dev only: really send Telegram messages from a non-production server (default: write to $TMP/edge-tasks-outbox.jsonl)
TELEGRAM_SEND_IN_DEV=
# roadmap, not used yet: mirror photos to Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
